# Required public Supabase project connection values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Required server-only HMAC signing key. Use at least 32 random bytes.
ATTENDANCE_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Optional canonical app origin used for invitation and recovery callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional comma-separated hostnames for Next.js dev assets when testing over LAN.
# Example: NEXT_ALLOWED_DEV_ORIGINS=192.168.1.20
NEXT_ALLOWED_DEV_ORIGINS=

# Optional server-only key; required only for the admin invitation feature.
# Never prefix with NEXT_PUBLIC_ or commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
